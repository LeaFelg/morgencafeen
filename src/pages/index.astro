---
import MainLayout from "../layouts/MainLayout.astro";

import Card from "../components/Card.astro";
---

<MainLayout title="Forside">
  <!--Hero sektion -->
  <article style="background-color: #762224;">
    <section class="relative w-full h-[90vh] overflow-hidden">
      <img
        src="/hero.png"
        alt="Hero billede"
        class="absolute inset-0 w-full h-full object-cover block"
      />
      <div
        class="absolute top-4 right-4 ml-50 md:ml-200 mt-30 text-wrap text-white font-extrabold drop-shadow-lg z-20"
      >
        <h1 class="m-0 text-2xl md:text-4xl">
          MED <i>DIN</i> HJÆLP KAN HJEMLØSE FÅ ET MÅLTID
        </h1>
      </div>
    </section>

    <!-- Donation cards -->
    <div
      class="transform -translate-y-4 md:-translate-y-7 transform-gpu flex flex-col md:flex-row gap-3 md:gap-4 max-w-6xl mx-auto px-4 pb-8 justify-center items-center text-center"
    >
      <div
        class="flex-1 basis-0 min-w-[220px] w-full relative z-30 flex justify-center"
      >
        <Card
          src="mobilepay.svg"
          alt="MobilePay logo"
          h3="STØT VIA MOBILEPAY"
          p="SEND ET VALGFRIT BELØB TIL 21902"
        />
      </div>

      <div
        class="flex-1 basis-0 min-w-[220px] w-full relative z-30 flex justify-center"
      >
        <Card
          src="sms.svg"
          alt="SMS icon"
          h3="STØT VIA SMS"
          p="SMS MORGENCAFEEN TIL 61690564 OG STØT MED 100 KR"
        />
      </div>

      <div
        class="flex-1 basis-0 min-w-[220px] w-full relative z-30 flex justify-center"
      >
        <Card
          src="bank.svg"
          alt="Bank icon"
          h3="BANKOVERFØRSEL"
          p="REG: 5338 KONTO NR: 0251236"
        />
      </div>
    </div>
  </article>

  <!--Introduktion -->
  <section class="bg-white py-12">
    <div class="max-w-6xl mx-4 md:mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div
          class="text-left intersect:animate-fade-right intersect:duration-9000"
        >
          <h1
            class="text-3xl font-bold mb-0 inline-block"
            style="color: #762224"
          >
            Mad og omsorg i mere end 30 år
          </h1>
          <div class="w-46 border-b-4 mt-2 mb-4" style="border-color: #762224">
          </div>
          <p class="text-black mb-6">
            Morgencafé for Hjemløse arbejder for at nedbringe hjemløshed samt
            forbedre livsvilkårene for socialt udsatte. Størstedelen af
            Morgencaféens brugere er hjemløse, alkoholikere, psykisk syge og
            andre socialt udsatte.
          </p>
          <p>
            De er sårbare og udsatte, og fælles for dem er, at de bruger
            Morgencaféen som et fast holdepunkt i en omtumlet tilværelse.
            Morgencaféen serverer mad, uddeler tøj og soveposer samt tilbyder
            lægehjælp, fysioterapi, fodterapi, klipning og juridisk rådgivning.
          </p>
          <p>
            Morgencaféen afholder derudover julearrangementer, grønlandsk
            madklub og banko samt tager på ferie- sommer- fiske- og naturture
            for at forbedre hjemløses og socialt udsattes livskvalitet. Stedet
            kunne ikke eksistere uden de mange frivillige, der hver især viser
            deres store engagement gennem deres omsorg for udsatte, der ofte
            ikke har andre fortrolige at tale med i deres liv.
          </p>

          <button
            class="mt-6 text-white py-2 px-4 rounded bg-[#762224] hover:bg-[#E4B539] transition-colors"
          >
            DONER NU
          </button>
        </div>

        <div
          class="flex justify-center intersect:animate-fade-left intersect:duration-9000 md:justify-end"
        >
          <img
            src="imggivefood.png"
            alt="Support illustration"
            class="w-full max-w-md object-cover"
          />
        </div>
      </div>
    </div>
  </section>
  <!-- Historie -->
  <section class="bg-[#FAF0D7] py-12">
    <div class="max-w-6xl mx-auto px-10 py-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
        <div class="flex justify-center md:justify-start">
          <img
            src="story-img.png"
            alt="Support illustration"
            class="w-[400px] h-[400px] object-cover rounded-full border-[15px] border-yellow-500 intersect:animate-fade-up intersect:duration-900"
          />
        </div>
        <div class="text-left flex flex-col justify-center">
          <img
            src="talebobble.svg"
            alt=""
            class="mb-10 mr-10 intersect:animate-fade-right intersect:duration-900"
          />
          <p class="text-black mb-6">
            Jens Andersen a.k.a. Jenno, kom som 40-årig forbi Morgencaféen, og
            fandt en ny retning på livet. Idag er Jenno billedkunstner og holder
            foredrag om sit liv som tidligere hjemløs, alkohol-og
            kokainmisbruger. Samt om sin lange seje vej ud på den anden side,
            hvor det gjaldt om at være stærk, – holde fast i sig selv, og være
            modig til at stå ved sine valg.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!--Faciliteter -->
  <section class="bg-white py-12">
    <div class="max-w-6xl mx-4 md:mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="text-left intersect:animate-fade-up intersect:duration-900">
          <h1
            class="text-3xl font-bold mb-0 inline-block"
            style="color: #762224"
          >
            Vores Projekter
          </h1>
          <div class="w-46 border-b-4 mt-2 mb-4" style="border-color: #762224">
          </div>
          <p class="text-black mb-6">
            Igennem årene har holdet af frivillige været med til at udvikle og
            nytænke projekter til gavn for socialt udsatte. I skrivende stund er
            vores projekter følgende: Sundhedsrummet, Hjælperiet,
            Bindeleddet, Retshjælp, Findstyrken.nu, GørenforskelNU,
            Hjemløsespillet, Festivalindsamling, og Gravplads for Gadens Folk.
          </p>

          <button
            class="mt-6 text-white py-2 px-4 rounded bg-[#762224] hover:bg-[#E4B539] transition-colors"
          >
            Vores faciliteter
          </button>
        </div>

        <div class="flex flex-col justify-center md:justify-end space-y-4">
          <img
            src="morgencafeen.png"
            alt="Support illustration"
            class="w-full max-w-md object-cover intersect:animate-fade-down intersect:duration-900"
          />
          <img
            src="sundhedsrum.png"
            alt="Support illustration"
            class="w-full max-w-md object-cover intersect:animate-fade-up intersect:duration-900"
          />
        </div>
      </div>
    </div>
  </section>
  <!--Galleri-->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold mb-6 text-center" style="color: #762224">
        Se billeder fra Morgencafeen
      </h2>
      <div class="flex overflow-x-auto space-x-10">
        <img
          src="galleryimg1.png"
          alt="Morgencaféen"
          class="w-94 h-64 object-cover"
        />
        <img
          src="galleryimg2.png"
          alt="Sundhedsrum"
          class="w-94 h-64 object-cover"
        />
        <img
          src="galleryimg3.png"
          alt="Hjælperiet"
          class="w-94 h-64 object-cover"
        />
        <img
          src="galleryimg4.png"
          alt="Bindeleddet"
          class="w-94 h-64 object-cover"
        />
        <img
          src="galleryimg5.png"
          alt="Retshjælp"
          class="w-94 h-64 object-cover"
        />
      </div>
    </div>
  </section>
  <div>
    <a href="/formular">Formular</a>
  </div>
</MainLayout>
