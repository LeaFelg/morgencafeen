---
const { src, alt, h3, p } = Astro.props;
---

<div
  class="rounded-xl w-64 h-74 flex flex-col items-center justify-center text-center bg-amber-100 shadow-md"
>
  <div
    class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center overflow-hidden mb-3"
  >
    <img src={src} alt={alt} class="w-10 h-10" />
  </div>

  <h3 class="font-bold text-lg">{h3}</h3>
  <p class="text-sm text-gray-500 mt-1">{p}</p>
</div>
