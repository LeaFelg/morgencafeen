---
const { src, alt, h3, p } = Astro.props;
---

<div
  class="rounded-xl p-10 w-64 h-74 flex flex-col items-center justify-center text-center shadow-md"
  style="background-color: #FAF0D7;"
>
  <div
    class="w-30 h-30 rounded-full bg-white flex items-center justify-center overflow-hidden mb-3"
  >
    <img src={src} alt={alt} class="w-15 h-15" />
  </div>

  <h3 class="font-bold text-lg">{h3}</h3>
  <p class="text-sm text-gray-500 mt-1">{p}</p>
</div>
