<header class="bg-white">
  <div class="max-w-6xl mx-auto my-5 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-start h-16">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-3"
        aria-label="MorgenCafeen home"
      >
        <img src="/logo.png" alt="MorgenCafeen logo" class="h-20 w-auto" />
        <span class="sr-only">MorgenCafeen</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:block ml-8" aria-label="Primary">
        <ul class="flex items-center space-x-6">
          <li>
            <a
              href="/"
              class="text-black text-[14px] font-medium hover:text-[#762224]"
              >HVEM ER VI</a
            >
          </li>
          <li>
            <a
              href="/"
              class="text-black text-[14px] font-medium hover:text-[#762224]"
              >FACILITETER</a
            >
          </li>
          <li>
            <a
              href="/"
              class="text-black text-[14px] font-medium hover:text-[#762224]"
              >PROJEKTER & SAMARBEJDER</a
            >
          </li>
          <li>
            <a
              href="/"
              class="text-black text-[14px] font-medium hover:text-[#762224]"
              >HISTORIER</a
            >
          </li>
          <li>
            <a
              href="/"
              class="text-black text-[14px] font-medium hover:text-[#762224]"
              >STØTTEMULIGHEDER</a
            >
          </li>
        </ul>
      </nav>

      <!-- Støt knap og burger menu -->
      <div class="ml-auto flex items-center gap-3">
        <!-- Støt knap desktop -->
        <a
          href="formular"
          class="hidden md:inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#762224] hover:bg-[#E4B539] font-medium focus:outline-none"
          aria-label="Støt MorgenCafeen"
        >
          <span class="text-white">STØT</span>
          <img src="heart.svg" alt="SVG hjerte ikon" class="h-4 w-4" />
        </a>

        <!-- Burgermenu -->
        <section class="md:hidden relative">
          <input
            id="nav-toggle"
            type="checkbox"
            class="peer sr-only"
            aria-hidden="true"
          />
          <label
            for="nav-toggle"
            class="inline-flex items-center justify-center p-2 rounded-md text-gray-800 hover:bg-gray-100 focus:outline-none cursor-pointer relative z-40"
            aria-label="Toggle menu"
            role="button"
            aria-controls="mobile-menu"
          >
            <span class="sr-only">Toggle menu</span>
            <img
              src="/burgermenu.svg"
              alt="Burgermenu ikon"
              class="h-6 w-6 burger-closed peer-checked:hidden inline-block"
            />
            <img
              src="/burgermenu.svg"
              alt="Luk menu"
              class="h-6 w-6 burger-open hidden peer-checked:inline-block"
            />
          </label>

          <!-- Mobil dropdown menu -->
          <div
            id="mobile-menu"
            class="dropdown-menu border bg-white px-2 pt-2 pb-3 space-y-1 absolute right-0 top-full mt-2 w-56 shadow-lg rounded-md hidden peer-checked:block z-50"
          >
            <a
              href="/"
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-[#762224]"
              >HVEM ER VI</a
            >
            <a
              href="/"
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-[#762224]"
              >FACILITETER</a
            >
            <a
              href="/"
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-[#762224]"
              >PROJEKTER & SAMARBEJDER</a
            >
            <a
              href="/"
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-[#762224]"
              >HISTORIER</a
            >
            <a
              href="/"
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-800 hover:bg-gray-50 hover:text-[#762224]"
              >STØTTEMULIGHEDER</a
            >

            <div class="px-3 pt-2">
              <a
                href="formular"
                class="w-full inline-flex justify-center items-center gap-2 px-4 py-2 rounded-full bg-[#762224] hover:bg-[#E4B539] font-medium text-white"
                aria-label="Støt MorgenCafeen"
              >
                <span>STØT</span>
                <img src="heart.svg" alt="SVG hjerte ikon" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</header>
